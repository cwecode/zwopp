{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Library window, capture overlays and the recording frame and bar",
  "windows": ["main", "overlay-*", "recorder-*"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-set-theme",
    "drag:default"
  ]
}
