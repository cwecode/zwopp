{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zwopp",
  "version": "1.2.0",
  "identifier": "digital.weier.zwopp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Zwopp",
        "width": 1100,
        "height": 720,
        "minWidth": 640,
        "minHeight": 420,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' thumb: http://thumb.localhost asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/library/**"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERCMEQ4RjE2Nzk4MUQ1MjkKUldRcDFZRjVGbzhOMi8xZHZGcUI0eGZTMHJSQUlmL3BpdEc3TnBzY1NMZ3RIdS9IZnRlQlFzY2sK",
      "endpoints": ["https://github.com/cwecode/zwopp/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
